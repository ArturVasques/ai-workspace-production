# Application
APP_ENV=development
LOG_LEVEL=INFO

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_workspace_production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# RAG
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.8